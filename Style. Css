body {
    font-family: Arial, sans-serif;
    background: #f0f4f8;
    margin: 0;
    padding: 0;
}

header {
    background: #2563eb;
    color: white;
    text-align: center;
    padding: 25px;
}

.container {
    max-width: 500px;
    margin: 25px auto;
    padding: 20px;
    background: white;
    border-radius: 10px;
}

h2 {
    color: #2563eb;
}

input, select, textarea {
    width: 100%;
    padding: 12px;
    margin: 8px 0;
    box-sizing: border-box;
    border: 1px solid #ccc;
    border-radius: 5px;
}

textarea {
    height: 90px;
}

button {
    width: 100%;
    padding: 12px;
    background: #2563eb;
    color: white;
    border: none;
    border-radius: 5px;
    cursor: pointer;
}

button:hover {
    background: #1d4ed8;
}

.item {
    background: #eaf2ff;
    padding: 12px;
    margin-top: 12px;
    border-radius: 5px;
    overflow-wrap: anywhere;
}

footer {
    text-align: center;
    padding: 15px;
    color: #555;
}